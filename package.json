{
  "name": "scylladb",
  "version": "1.0.0",
  "description": "ScyllaDB Node.js Driver",
  "type": "module",
  "keywords": [
    "scylla",
    "cassandra",
    "database",
    "cql",
    "nosql",
    "driver",
    "cassandra"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "murmurhash": "^2.0.0",
    "node-sql-parser": "^5.4.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "cassandra-driver": "^4.8.0",
    "eslint": "^10.2.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.58.0"
  },
  "engines": {
    "node": ">=22"
  },
  "main": "bin/index",
  "repository": {
    "type": "git",
    "url": "https://github.com/fed135/scylladb.git"
  },
  "bugs": {
    "url": "https://github.com/fed135/scylladb/issues"
  },
  "contributors": [
    "frederic charette <fredericcharette@gmail.com>"
  ],
  "typings": "./types.d.ts",
  "author": "frederic charette <fredericcharette@gmail.com>",
  "files": [
    "bin",
    "types.d.ts"
  ],
  "scripts": {
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --test ./src/**/*.test.ts",
    "test:integration": "node --test ./test/**/*.test.ts",
    "lint": "eslint ./**/*.ts",
    "lint:fix": "eslint ./**/*.ts --fix",
    "build": "tsc --outDir ./bin ./src/index.ts",
    "dev": "node ./test/workbench.ts"
  }
}
